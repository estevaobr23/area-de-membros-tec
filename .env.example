# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo usado para assinar o cookie de sessão (login por e-mail).
# Gere um valor aleatório forte, ex: openssl rand -hex 32
SESSION_SECRET=

# Segredo compartilhado com a Wiapy para validar a assinatura do webhook.
WIAPY_WEBHOOK_SECRET=

# Vercel Blob (store PRIVADO) — Dashboard > Storage > Create Database > Blob > Private.
BLOB_READ_WRITE_TOKEN=
